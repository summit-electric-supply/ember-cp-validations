{
  "name": "@summit-electric-supply/ember-cp-validations",
  "version": "4.1.0-beta.2",
  "description": "Ember computed property based validation library",
  "keywords": [
    "ember-addon"
  ],
  "homepage": "https://github.com/summit-electric-supply/ember-cp-validations",
  "repository": "https://github.com/summit-electric-supply/ember-cp-validations",
  "contributors": [
    "Ben Limmer <hello@benlimmer.com>",
    "Offir Golan <offirgolan@gmail.com> (https://github.com/offirgolan)",
    "Robert Jackson <me@rwjblue.com>",
    "Sherman James <scj619@gmail.com> (https://github.com/SCJLabs)",
    "Stefan Penner <stefan.penner@gmail.com>",
    "Steve Jabour <steve@jabour.me> (https://github.com/atsjj)"
  ],
  "directories": {
    "doc": "./doc",
    "test": "tests"
  },
  "scripts": {
    "doc": "typedoc",
    "build": "ember build --environment=production",
    "build:test": "ember build --environment=test",
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel 'lint:!(fix)'",
    "lint:dependency": "ember dependency-lint",
    "lint:fix": "npm-run-all --aggregate-output --continue-on-error --parallel lint:*:fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test:all": "ember try:each",
    "test:ember": "ember test",
    "test:ember-compatibility": "ember try:each",
    "ci:ember-compatibility": "ember try:one"
  },
  "dependencies": {
    "@summit-electric-supply/ember-validators": "^2.1.0-beta.1",
    "broccoli-funnel": "^3.0.2",
    "ember-bootstrap": "^5.1.1",
    "ember-cli-babel": "^7.26.6",
    "ember-cli-typescript": "^5.1.1"
  },
  "devDependencies": {
    "@ember/optional-features": "^2.0.0",
    "@ember/test-helpers": "^2.8.1",
    "@embroider/test-setup": "^2.0.0",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "@types/ember-qunit": "^5.0.2",
    "@types/ember-resolver": "^5.0.13",
    "@types/ember__application": "^4.0.5",
    "@types/ember__array": "^4.0.3",
    "@types/ember__component": "^4.0.11",
    "@types/ember__controller": "^4.0.4",
    "@types/ember__debug": "^4.0.3",
    "@types/ember__engine": "^4.0.4",
    "@types/ember__error": "^4.0.1",
    "@types/ember__object": "^4.0.5",
    "@types/ember__polyfills": "^4.0.1",
    "@types/ember__routing": "^4.0.12",
    "@types/ember__runloop": "^4.0.2",
    "@types/ember__service": "^4.0.1",
    "@types/ember__string": "^3.0.10",
    "@types/ember__template": "^4.0.1",
    "@types/ember__test": "^4.0.1",
    "@types/ember__test-helpers": "^2.8.2",
    "@types/ember__utils": "^4.0.2",
    "@types/htmlbars-inline-precompile": "^3.0.0",
    "@types/qunit": "^2.19.3",
    "@types/rsvp": "^4.0.4",
    "@typescript-eslint/eslint-plugin": "^5.45.1",
    "@typescript-eslint/parser": "^5.45.1",
    "babel-eslint": "^10.1.0",
    "bootstrap": "^5.0.0",
    "broccoli-asset-rev": "^3.0.0",
    "ember-auto-import": "^2.5.0",
    "ember-cli": "~4.8.0",
    "ember-cli-code-coverage": "^1.0.0",
    "ember-cli-dependency-checker": "^3.3.1",
    "ember-cli-dependency-lint": "^1.1.3",
    "ember-cli-github-pages": "^0.2.2",
    "ember-cli-htmlbars": "^6.1.1",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-postcss": "^8.2.0",
    "ember-cli-sass": "^10.0.1",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-cli-yuidoc": "^0.9.1",
    "ember-code-snippet": "^3.0.0",
    "ember-data": "^4.9.1",
    "ember-disable-prototype-extensions": "^1.1.3",
    "ember-exam": "^5.0.1",
    "ember-export-application-global": "^2.0.1",
    "ember-load-initializers": "^2.1.2",
    "ember-maybe-import-regenerator": "^0.1.6",
    "ember-moment": "^10.0.0",
    "ember-page-title": "^6.2.1",
    "ember-prism": "^0.8.2",
    "ember-qunit": "^6.0.0",
    "ember-resolver": "^8.0.3",
    "ember-source": "^4.9.1",
    "ember-source-channel-url": "^3.0.0",
    "ember-try": "^2.0.0",
    "eslint": "^8.29.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-ember": "^11.2.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-qunit": "^7.3.4",
    "lint-staged": ">=10",
    "loader.js": "^4.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.0",
    "qunit": "^2.19.3",
    "qunit-dom": "^2.0.0",
    "release-it": "^15.4.1",
    "release-it-lerna-changelog": "^5.0.0",
    "sass": "^1.26.10",
    "typedoc": "^0.23.14",
    "typescript": "^4.9.3",
    "webpack": "^5.75.0",
    "yuidoc-ember-theme": "^2.0.1"
  },
  "engines": {
    "node": "12.* || 14.* || >= 16"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config",
    "demoURL": "https://summit-electric-supply.github.io/ember-cp-validations"
  },
  "release-it": {
    "hooks": {
      "after:release": [
        "ember github-pages:commit --message \"Released '${version}'\"",
        "git push origin gh-pages:gh-pages"
      ]
    },
    "plugins": {
      "release-it-lerna-changelog": {
        "infile": "CHANGELOG.md",
        "launchEditor": true
      }
    },
    "git": {
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "tokenRef": "GITHUB_AUTH"
    }
  },
  "resolutions": {
    "@embroider/macros": "1.10.0"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix"
  }
}
